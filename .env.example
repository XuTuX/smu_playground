# Local ESP32 / admin configuration (no Supabase required)
DEVICE_API_KEY=replace-with-a-long-random-device-key
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
NEXT_PUBLIC_REGISTERED_RESET_SECONDS=12

# Google Sheets score store. Keep disabled until all credentials are configured.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_SHEETS_SCORE_RANGE="'점수'!A1:J"
GOOGLE_SHEETS_APPEND_RANGE="'점수'!A:J"
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account-email
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_CACHE_SECONDS=5
# true: sheet input only, false: admin/ESP32 registrations are also appended.
GOOGLE_SHEETS_READ_ONLY=false
